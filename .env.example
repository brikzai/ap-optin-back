ENVIRONMENT=development
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=*

# JWT do IdP corporativo (API interna)
IAM_JWT_PUBLIC_KEY=
IAM_JWT_ISSUER=brikz-iam

# Multi-tenancy — um segredo JSON por tenant (financiador), chave = CNPJ.
# Ver docs/superpowers/specs/2026-08-24-multitenancy-design.md §3.
TENANT_12345678000199_CONFIG={"cloudsql_connection_name":"","cloudsql_db_user":"","cloudsql_db_password":"","cloudsql_db_name":"","cerc_client_id":"","cerc_client_secret":"","cerc_cnpj_solicitante":"12345678000199"}

# CERC (homologação) — ver docs/superpowers/specs/2026-08-18-optin-service-design.md §5
CERC_AUTH_URL=https://api.int.cerc.com/oauth/token
CERC_API_BASE_URL=https://ap-homolog.cerc.inf.br

# CORS — origens da SPA (ap-front) autorizadas a chamar esta API.
# Dev local: http://localhost:5173 (porta padrão do Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173
