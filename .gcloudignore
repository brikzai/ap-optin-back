# Controla o que `gcloud builds submit` envia como fonte do build (independente
# do .dockerignore, que só controla o contexto do `docker build` já enviado).
# Explícito em vez de depender do fallback (#!include:.gitignore) — a chave
# privada de JWT (keys/) nunca pode viajar para o Cloud Build.
.git
.gitignore
.claude
.superpowers
.venv
venv
__pycache__
*.pyc
.pytest_cache
*.pem
**/*.pem
keys/
logs
.env
.env.*
!.env.example
